# Private context (see AGENTS.md)
.private/

# Agent-runtime state. Regenerated per session, hand-edited by nobody, and
# never part of any history.
# Claude Code / oh-my-claudecode:
.omc/
.claude/
# Codex / oh-my-codex:
.omx/

# Dependencies and generated framework state. Written without a leading slash so
# they match at any depth, the same reason the runtime-state patterns above are.
# Build output is NOT listed here: each package anchors its own `/dist` and `/build`,
# and an unanchored pattern would silently untrack a future `scripts/build/`.
node_modules/
.svelte-kit/

# pnpm's package store, when it lands in the tree instead of the home cache. A tool run in
# a sandbox whose $HOME is not the user's makes `pnpm install` inside it unable to reach
# `~/.local/share/pnpm/store`, so it falls back to a store beside the lockfile.
# It is 144 MB of content-addressed blobs, and it is not merely untracked-and-harmless:
# `prettier --check .` walks it and `pnpm lint` goes red for everyone afterwards, on a
# path nobody edited. Ignored here and in `.prettierignore`, which is the layer that
# actually stops the walk.
.pnpm-store/

# Pinned upstream checkouts (scripts/tokens/fetch.mjs, scripts/gallery/fetch.mjs).
# Materialised on demand, never tracked: they are sparse clones of someone else's
# repositories, and each record file under `data/` carries the commit it was read at.
.upstream/

# Playwright
test-results/
playwright-report/
blob-report/

# Visual baselines. Only the Windows set is tracked: it is the one where Segoe UI
# Variable resolves, so it is the only one whose pixels mean anything. Directories are
# named for where the browser ran, not for where the test runner ran.
tests/visual/__screenshots__/chromium-linux/

# Secrets. `.gitignore` is the first layer only — the pre-commit hook refuses these
# too, because this is the class where `git add -f` is exactly what someone does.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# OS cruft
.DS_Store
Thumbs.db
