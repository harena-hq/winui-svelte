	"languages": [
		{
			"id": "xml",
			"name": "XML",
			"cssClassName": "xml",
			"aliases": [
				"xaml",
				"axml"
			],
			"rules": [
				{
					"pattern": "\\<![ \\r\\n\\t]*(--([^\\-]|[\\r\\n]|-[^\\-])*--[ \\r\\n\\t]*)\\>",
					"captures": {
						"0": "HTML Comment"
					}
				},
				{
					"pattern": "(?i)(<!)(doctype)(?:\\s+([a-z0-9]+))*(?:\\s+(\")([^\\n]*?)(\"))*(>)",
					"captures": {
						"1": "XML Delimiter",
						"2": "XML Name",
						"3": "XML Attribute",
						"4": "XML Attribute Quotes",
						"5": "XML Attribute Value",
						"6": "XML Attribute Quotes",
						"7": "XML Delimiter"
					}
				},
				{
					"pattern": "(?i)(<\\?)(xml-stylesheet)((?:\\s+[a-z0-9]+=\"[^\\n\"]*\")*(?:\\s+[a-z0-9]+=\\'[^\\n\\']*\\')*\\s*?)(\\?>)",
					"captures": {
						"1": "XML Delimiter",
						"2": "XML Name",
						"3": "XML Doc Tag",
						"4": "XML Delimiter"
					}
				},
				{
					"pattern": "(?i)(<\\?)([a-z][a-z0-9-]*)(?:\\s+([a-z0-9]+)(=)(\")([^\\n]*?)(\"))*(?:\\s+([a-z0-9]+)(=)(\\')([^\\n]*?)(\\'))*\\s*?(\\?>)",
					"captures": {
						"1": "XML Delimiter",
						"2": "XML Name",
						"3": "XML Attribute",
						"4": "XML Delimiter",
						"5": "XML Attribute Quotes",
						"6": "XML Attribute Value",
						"7": "XML Attribute Quotes",
						"8": "XML Attribute",
						"9": "XML Delimiter",
						"10": "XML Attribute Quotes",
						"11": "XML Attribute Value",
						"12": "XML Attribute Quotes",
						"13": "XML Delimiter"
					}
				},
				{
					"pattern": "(?xi)(</?)\n                                          (?: ([a-z][a-z0-9-]*)(:) )*\n                                          ([a-z][a-z0-9-_\\.]*)\n                                          (?:\n                                            |[\\s\\n]+([a-z0-9-_\\.:]+)[\\s\\n]*(=)[\\s\\n]*(\")([^\\n]+?)(\")\n                                            |[\\s\\n]+([a-z0-9-_\\.:]+)[\\s\\n]*(=)[\\s\\n]*(')([^\\n]+?)(')\n                                            |[\\s\\n]+([a-z0-9-_\\.:]+) )*\n                                          [\\s\\n]*\n                                          (/?>)",
					"captures": {
						"1": "XML Delimiter",
						"2": "XML Name",
						"3": "XML Delimiter",
						"4": "XML Name",
						"5": "XML Attribute",
						"6": "XML Delimiter",
						"7": "XML Attribute Quotes",
						"8": "XML Attribute Value",
						"9": "XML Attribute Quotes",
						"10": "XML Attribute",
						"11": "XML Delimiter",
						"12": "XML Attribute Quotes",
						"13": "XML Attribute Value",
						"14": "XML Attribute Quotes",
						"15": "XML Attribute",
						"16": "XML Delimiter"
					}
				},
				{
					"pattern": "(?i)&[a-z0-9]+?;",
					"captures": {
						"0": "XML Attribute"
					}
				},
				{
					"pattern": "(?s)(<!\\[CDATA\\[)(.*?)(\\]\\]>)",
					"captures": {
						"1": "XML Delimiter",
						"2": "XML CData Section",
						"3": "XML Delimiter"
					}
				}
			]
		},
		{
			"id": "c#",
			"name": "C#",
			"cssClassName": "csharp",
			"aliases": [
				"cs",
				"c#",
				"csharp",
				"cake"
			],
			"rules": [
				{
					"pattern": "/\\*([^*]|[\\r\\n]|(\\*+([^*/]|[\\r\\n])))*\\*+/",
					"captures": {
						"0": "Comment"
					}
				},
				{
					"pattern": "(///)(?:\\s*?(<[/a-zA-Z0-9\\s\"=]+>))*([^\\r\\n]*)",
					"captures": {
						"1": "XML Doc Tag",
						"2": "XML Doc Tag",
						"3": "XML Doc Comment"
					}
				},
				{
					"pattern": "(//.*?)\\r?$",
					"captures": {
						"1": "Comment"
					}
				},
				{
					"pattern": "'[^\\n]*?(?<!\\\\)'",
					"captures": {
						"0": "String"
					}
				},
				{
					"pattern": "(?s)@\"(?:\"\"|.)*?\"(?!\")",
					"captures": {
						"0": "String (C# @ Verbatim)"
					}
				},
				{
					"pattern": "(?s)(\"[^\\n]*?(?<!\\\\)\")",
					"captures": {
						"0": "String"
					}
				},
				{
					"pattern": "\\[(assembly|module|type|return|param|method|field|property|event):[^\\]\"]*(\"[^\\n]*?(?<!\\\\)\")?[^\\]]*\\]",
					"captures": {
						"1": "Keyword",
						"2": "String"
					}
				},
				{
					"pattern": "^\\s*(\\#define|\\#elif|\\#else|\\#endif|\\#endregion|\\#error|\\#if|\\#line|\\#pragma|\\#region|\\#undef|\\#warning).*?$",
					"captures": {
						"1": "Preprocessor Keyword"
					}
				},
				{
					"pattern": "\\b(abstract|as|ascending|base|bool|break|by|byte|case|catch|char|checked|class|const|continue|decimal|default|delegate|descending|do|double|dynamic|else|enum|equals|event|explicit|extern|false|finally|fixed|float|for|foreach|from|get|goto|group|if|implicit|in|int|into|interface|internal|is|join|let|lock|long|namespace|new|null|object|on|operator|orderby|out|override|params|partial|private|protected|public|readonly|ref|return|sbyte|sealed|select|set|short|sizeof|stackalloc|static|string|struct|switch|this|throw|true|try|typeof|uint|ulong|unchecked|unsafe|ushort|using|var|virtual|void|volatile|where|while|yield|async|await|warning|disable)\\b",
					"captures": {
						"1": "Keyword"
					}
				},
				{
					"pattern": "\\b[0-9]{1,}\\b",
					"captures": {
						"0": "Number"
					}
				}
			]
		}
	]
