{
	"name": "winui-svelte-workspace",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.23.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "pnpm -r build",
		"check": "tsc --noEmit && pnpm -r check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"conform": "node scripts/conformance/run.mjs",
		"smoke": "node scripts/smoke/run.mjs",
		"tokens:fetch": "node scripts/tokens/fetch.mjs",
		"tokens:extract": "node scripts/tokens/extract.mjs",
		"tokens:build": "node scripts/tokens/generate.mjs",
		"symbol:extract": "node scripts/symbol/extract.mjs",
		"symbol:build": "node scripts/symbol/generate.mjs",
		"gallery:fetch": "node scripts/gallery/fetch.mjs",
		"gallery:extract": "node scripts/gallery/extract.mjs",
		"colorcode:fetch": "node scripts/colorcode/fetch.mjs",
		"colorcode:extract": "node scripts/colorcode/extract.mjs",
		"framework:fetch": "node scripts/framework/fetch.mjs",
		"framework:extract": "node scripts/framework/extract.mjs",
		"test": "playwright test",
		"verify": "pnpm build && pnpm check && pnpm lint && pnpm conform && pnpm smoke && pnpm gate",
		"gate": "node scripts/gate/acceptance.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.4.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"sirv-cli": "^3.0.1",
		"svelte": "^5.57.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0"
	}
}
