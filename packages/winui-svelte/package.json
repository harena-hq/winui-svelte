{
	"name": "winui-svelte",
	"version": "0.1.0",
	"description": "WinUI 3 controls for Svelte 5",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "svelte-kit sync && svelte-package && node ../../scripts/package/strip-script-lang.mjs && publint",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"files": [
		"dist",
		"LICENSE",
		"NOTICE.md",
		"CHANGELOG.md",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./preview": {
			"types": "./dist/preview.d.ts",
			"svelte": "./dist/preview.js",
			"default": "./dist/preview.js"
		},
		"./tokens.css": "./dist/tokens/tokens.css",
		"./type-ramp.css": "./dist/tokens/type-ramp.css",
		"./*.svelte": {
			"types": "./dist/*.svelte.d.ts",
			"svelte": "./dist/*.svelte",
			"default": "./dist/*.svelte"
		},
		"./*": "./dist/*"
	},
	"peerDependencies": {
		"@internationalized/date": "^3.12.3",
		"@zag-js/number-input": "^1.43.3",
		"@zag-js/svelte": "^1.43.3",
		"bits-ui": "^2.19.0",
		"svelte": "^5.37.0"
	},
	"peerDependenciesMeta": {
		"@zag-js/number-input": {
			"optional": true
		},
		"@zag-js/svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@zag-js/number-input": "^1.43.3",
		"@zag-js/svelte": "^1.43.3",
		"bits-ui": "^2.19.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.0",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"keywords": [
		"svelte",
		"winui",
		"fluent",
		"windows"
	]
}
