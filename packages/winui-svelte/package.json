{
	"name": "winui-svelte",
	"version": "0.0.0",
	"description": "WinUI 3 controls for Svelte 5",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "svelte-kit sync && svelte-package && publint",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"files": [
		"dist",
		"LICENSE",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./*": "./dist/*"
	},
	"peerDependencies": {
		"@internationalized/date": "^3.8.1",
		"bits-ui": "^2.19.0",
		"svelte": "^5.33.0"
	},
	"devDependencies": {
		"@internationalized/date": "^3.8.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"bits-ui": "^2.19.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"keywords": [
		"svelte",
		"winui",
		"fluent",
		"windows"
	]
}
